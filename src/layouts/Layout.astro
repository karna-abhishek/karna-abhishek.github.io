---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  active?: string;
}

const {
  title,
  description = 'Abhishek Karna, PhD student in physics at Princeton University.',
  active = '',
} = Astro.props;

const nav = [
  { label: 'Research', href: '/research' },
  { label: 'Publications', href: '/publications' },
  { label: 'Writing', href: '/writing' },
  { label: 'Elsewhere', href: '/elsewhere' },
  { label: 'CV', href: '/resume.pdf' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Abhishek Karna" />
  <title>{title === 'Home' ? 'Abhishek Karna' : `${title} · Abhishek Karna`}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a href="/" class="site-name">Abhishek Karna</a>
      <ul class="site-nav">
        {nav.map(item => (
          <li><a href={item.href} class={active === item.label ? 'active' : ''}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </header>

  <main>
    <div class="wrap">
      <slot />
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap">&copy; 2026 Abhishek Karna</div>
  </footer>
</body>
</html>
