---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Presentations" active="Presentations" description="Conference talks, posters, and presentations by Abhishek Karna">

  <section class="page-header page-header-photo" style="background-image: url('/photos/presentations.jpg'); background-position: center 30%;">
    <div class="container">
      <h1>Presentations</h1>
      <p>Talks and posters at conferences and workshops</p>
    </div>
  </section>

  <section class="presentations-section">
    <div class="container">
      <ul class="timeline">

        <li class="timeline-item">
          <div class="timeline-date">Mar 16&ndash;20, 2026</div>
          <div class="timeline-content">
            <h3>APS Global Physics Summit 2026 &mdash; Combined March &amp; April Meeting</h3>
            <p class="timeline-location">
              <i class="fas fa-map-marker-alt"></i> Denver, Colorado
            </p>
            <p class="timeline-talk">
              Projected Thermal Density Matrix Monte Carlo on the Shastry&ndash;Sutherland Model
            </p>
          </div>
        </li>

        <li class="timeline-item">
          <div class="timeline-date">Oct 12&ndash;17, 2025</div>
          <div class="timeline-content">
            <h3>International Conference on Strongly Correlated Quantum Materials (ICSCQM)</h3>
            <p class="timeline-location">
              <i class="fas fa-map-marker-alt"></i> Hvar, Croatia
            </p>
            <p class="timeline-talk">
              Low-energy spectrum of the Shastry&ndash;Sutherland Model on small lattices using a new Monte Carlo
            </p>
          </div>
        </li>

        <li class="timeline-item">
          <div class="timeline-date">Mar 16&ndash;22, 2025</div>
          <div class="timeline-content">
            <h3>APS Global Physics Summit 2025 &mdash; Combined March &amp; April Meeting</h3>
            <p class="timeline-location">
              <i class="fas fa-map-marker-alt"></i> Anaheim, California
            </p>
            <p class="timeline-talk">
              Experimental synthesis, single crystal growth, &amp; characterization of NdFeO<sub>3</sub>
            </p>
          </div>
        </li>

      </ul>
    </div>
  </section>

</Layout>
