---
import Layout from '../layouts/Layout.astro';

// Add blog posts here as they are written.
// file: path to a page route (e.g. '/blog/post-slug') or external URL
const blogPosts: {
  title: string;
  date: string;
  description: string;
  file?: string;
  coming_soon?: boolean;
}[] = [
  {
    title: "Why the Sign Problem is Hard (and Why We Try Anyway)",
    date: "Forthcoming",
    description: "An informal look at the sign problem in quantum Monte Carlo and the strategies used to work around it.",
    coming_soon: true,
  },
  {
    title: "What is a Frustrated Magnet?",
    date: "Forthcoming",
    description: "Spins on a triangle, competing interactions, and the strange phases that emerge when a system cannot satisfy all its constraints simultaneously.",
    coming_soon: true,
  },
  {
    title: "Machine Learning Meets Quantum Materials",
    date: "Forthcoming",
    description: "How physics-informed ML is changing the way we search for high-Tc superconductors and novel magnetic materials.",
    coming_soon: true,
  },
];

// Add lecture notes / PDF notes here.
const notes: {
  title: string;
  description: string;
  file?: string;
  coming_soon?: boolean;
}[] = [
  {
    title: "Notes on the Shastry–Sutherland Model",
    description: "Derivation of the orthogonal-dimer ground state, exact solution, and overview of the phase diagram.",
    coming_soon: true,
  },
  {
    title: "Introduction to Quantum Monte Carlo",
    description: "Path integral formulation, importance sampling, and the PDMS method.",
    coming_soon: true,
  },
  {
    title: "Tensor Networks: A Physicist's Introduction",
    description: "MPS, DMRG, and why contracting a tensor network is hard in general but tractable in 1D.",
    coming_soon: true,
  },
];
---

<Layout title="Physics" active="Physics" description="Physics — Abhishek Karna">

  <section class="page-header page-header-photo" style="background-image: url('/photos/2.jpg'); background-position: center 68%;">
    <div class="container" style="margin-left: 0; margin-right: auto;">
      <h1>Physics</h1>
      <p>Tidbits about my professional work and perspectives</p>
    </div>
  </section>

  <!-- ── RESEARCH ──────────────────────────────── -->
  <section class="physics-hub-section">
    <div class="container">
      <span class="eyebrow">Research</span>

      <div class="hub-research-grid">

        <a href="#ml" class="hub-research-item">
          <div class="hub-research-header">
            <h3>Physics-Informed ML for Quantum Magnets</h3>
            <span class="hub-tag">Current</span>
          </div>
          <p>Predicting high-T&#x2093; superconductors, universal electron-phonon coupling, and magnetic transition temperatures using physics-informed machine learning.</p>
        </a>

        <a href="#pdms" class="hub-research-item">
          <div class="hub-research-header">
            <h3>Projected Density Matrix Sampling</h3>
            <span class="hub-tag">Published</span>
          </div>
          <p>A continuous-time quantum Monte Carlo for the low-lying spectrum of generic lattice Hamiltonians, free of Trotter errors. <em>Physical Review D</em> 113, 074511 (2026).</p>
        </a>

        <a href="#materials" class="hub-research-item">
          <div class="hub-research-header">
            <h3>Quantum Materials Synthesis</h3>
          </div>
          <p>Synthesis and single-crystal growth of frustrated spinels, perovskites, and borides for neutron scattering studies.</p>
        </a>

        <a href="#atmospheric" class="hub-research-item">
          <div class="hub-research-header">
            <h3>Atmospheric Pollution Modeling</h3>
            <span class="hub-tag">Published</span>
          </div>
          <p>HYSPLIT trajectory modeling of transboundary PM&#8322;.&#8325; transport in Nepal and the Indo-Gangetic Plain. <em>Atmospheric Pollution Research</em> (2026).</p>
        </a>

        <a href="#collider" class="hub-research-item">
          <div class="hub-research-header">
            <h3>HL-LHC Track Reconstruction</h3>
          </div>
          <p>Wedge and spacepoint algorithms for real-time silicon track-trigger reconstruction at the HL-LHC, targeting metastable dark matter candidates.</p>
        </a>

      </div>

    </div>
  </section>

  <!-- ── BLOG ──────────────────────────────────── -->
  <section class="physics-hub-section alt">
    <div class="container">
      <span class="eyebrow">Blog</span>
      <p class="hub-section-desc">Short posts on quantum condensed matter, numerical methods, and ideas I find worth thinking about.</p>

      <ul class="hub-list">
        {blogPosts.map(post => (
          <li class={`hub-list-item${post.coming_soon ? ' coming-soon' : ''}`}>
            <div>
              <div class="hub-item-meta">{post.date}</div>
              <p class="hub-item-title">{post.title}</p>
              <p class="hub-item-desc">{post.description}</p>
            </div>
            {post.coming_soon ? (
              <span class="soon-badge">Soon</span>
            ) : (
              <a href={post.file} class="inline-link">Read <i class="fas fa-arrow-right" style="font-size:0.7rem;"></i></a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── NOTES ─────────────────────────────────── -->
  <section class="physics-hub-section">
    <div class="container">
      <span class="eyebrow">Notes</span>
      <p class="hub-section-desc">Lecture notes and expository PDFs on topics I have worked through carefully enough to write down.</p>

      <ul class="hub-list">
        {notes.map(note => (
          <li class={`hub-list-item${note.coming_soon ? ' coming-soon' : ''}`}>
            <div>
              <p class="hub-item-title">{note.title}</p>
              <p class="hub-item-desc">{note.description}</p>
            </div>
            {note.coming_soon ? (
              <span class="soon-badge">Soon</span>
            ) : (
              <a href={note.file} target="_blank" class="btn">
                <i class="fas fa-file-pdf"></i> PDF
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── RESEARCH DETAIL ───────────────────────── -->
  <section class="research-section alt" id="ml">
    <div class="container">
      <div class="research-header">
        <h2>Physics-Informed ML for Quantum Magnets</h2>
        <div class="research-meta">
          <span><i class="fas fa-university"></i> Princeton University</span>
          <span><i class="fas fa-calendar"></i> 2026 &ndash; Present</span>
        </div>
      </div>
      <div class="research-body">
        <p>
          My current research develops physics-informed machine learning methods for quantum magnetic materials.
          The three main threads are: predicting high-T&#x2093; superconductors from material descriptors;
          building a universal electron-phonon coupling calculator; and large-scale screening for materials
          with high Curie and Néel temperatures.
        </p>
      </div>
    </div>
  </section>

  <section class="research-section" id="pdms">
    <div class="container">
      <div class="research-header">
        <h2>Projected Density Matrix Sampling for Lattice Hamiltonians</h2>
        <div class="research-meta">
          <span><i class="fas fa-university"></i> Duke University</span>
          <span><i class="fas fa-user"></i> Prof. Shailesh Chandrasekharan</span>
          <span><i class="fas fa-calendar"></i> May 2024 &ndash; 2026</span>
        </div>
      </div>
      <div class="research-body">
        <p>
          Quantum Monte Carlo methods are among the most powerful tools for studying quantum many-body systems,
          but frustrated models generically suffer from the sign problem. Even where the ground state is
          accessible, obtaining excited states reliably remains an open challenge.
        </p>
        <p>
          I developed the Projected Density Matrix Sampling (PDMS) method: a continuous-time path-integral
          Monte Carlo approach for computing low-lying spectra of generic lattice Hamiltonians. PDMS samples
          within a carefully chosen projection subspace while maintaining ergodicity and detailed balance,
          achieving rapid convergence in sign-free systems and yielding spectral information even in the
          presence of sign problems. Applied to the Shastry–Sutherland model and the 1D Transverse Field
          Ising Model near the E&#8328; critical point. First-author paper under review at <em>Physical Review D</em>.
        </p>
      </div>
      <div class="research-links">
        <a href="https://journals.aps.org/prd/abstract/10.1103/gtbl-vsdt" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <i class="fas fa-external-link-alt"></i> Physical Review D
        </a>
        <a href="https://arxiv.org/abs/2511.19209" target="_blank" rel="noopener noreferrer" class="btn">
          <i class="fas fa-file-alt"></i> arXiv
        </a>
        <a href="https://drive.google.com/file/d/1_Y61qJXp79gWbo2lJYBWalwq9FMnr7-t/view?usp=drive_link" target="_blank" rel="noopener noreferrer" class="btn">
          <i class="fas fa-file-pdf"></i> Poster (ICSCQM 2025)
        </a>
        <a href="/pdms-presentation.pdf" target="_blank" class="btn">
          <i class="fas fa-file-pdf"></i> Talk (Max Planck, Feb 2026)
        </a>
      </div>
    </div>
  </section>

  <section class="research-section alt" id="materials">
    <div class="container">
      <div class="research-header">
        <h2>Quantum Materials Synthesis and Characterization</h2>
        <div class="research-meta">
          <span><i class="fas fa-university"></i> Duke University</span>
          <span><i class="fas fa-user"></i> Prof. Sara Haravifard</span>
          <span><i class="fas fa-calendar"></i> Aug 2022 &ndash; 2026</span>
        </div>
      </div>
      <div class="research-body">
        <p>
          I joined the Haravifard Lab in my first year to work on frustrated quantum materials. For spinel
          compounds (Cr-doped ZnAl&#8322;O&#8324; and Li-doped ZnV&#8322;O&#8324;), I synthesized phase-pure
          samples via solid-state techniques and used high-resolution XRD with Rietveld refinement to determine
          lattice parameters across dopings and quantify deviations from Vegard's law. I also performed arc
          melting on TmB&#8324; and HoB&#8324;, metallic altermagnet candidates related to the Shastry–Sutherland
          lattice.
        </p>
        <p>
          For perovskites, I synthesized phase-pure NdFeO&#8323;, a theoretical topological magnon candidate,
          and grew a single crystal using the optical floating zone furnace. I performed Laue scattering for
          orientation alignment and PPMS measurements to obtain temperature-dependent magnetization and hysteresis
          curves. The crystal is currently being re-grown for inelastic neutron scattering studies.
        </p>
      </div>
      <div class="research-links">
        <a href="/projects/APS Global Physics Summit - Karna, Abhishek - 2025.pdf" target="_blank" class="btn">
          <i class="fas fa-file-pdf"></i> Poster (APS 2025)
        </a>
        <a href="/projects/Spinel + Topological Magnon - Karna, Abhishek - 2024.pdf" target="_blank" class="btn">
          <i class="fas fa-file-pdf"></i> Poster (Symposium 2024)
        </a>
        <a href="/projects/Spinel_Doping - Karna, Abhishek - 2023.pdf" target="_blank" class="btn">
          <i class="fas fa-file-pdf"></i> Poster (Symposium 2023)
        </a>
      </div>
    </div>
  </section>

  <section class="research-section" id="atmospheric">
    <div class="container">
      <div class="research-header">
        <h2>Atmospheric Pollution and Climate Physics</h2>
        <div class="research-meta">
          <span><i class="fas fa-university"></i> Duke University</span>
          <span><i class="fas fa-user"></i> Prof. Brian G. McAdoo</span>
          <span><i class="fas fa-calendar"></i> Nov 2022 &ndash; 2026</span>
        </div>
      </div>
      <div class="research-body">
        <p>
          Working with Prof. McAdoo's group, I modeled transboundary PM&#8322;.&#8325; dynamics in Nepal and
          the Indo-Gangetic Plain using HYSPLIT back-trajectory analysis, aerosol optical depth (AOD), and
          potential source contribution functions (PSCF). I examined diurnal PM&#8322;.&#8325; patterns,
          planetary boundary layer height, and ventilation coefficients to isolate local and non-local pollution
          sources. Co-first-author paper published in <em>Atmospheric Pollution Research</em>, 2026.
        </p>
      </div>
      <div class="research-links">
        <a href="https://doi.org/10.1016/j.apr.2026.102920" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <i class="fas fa-file-alt"></i> Published Paper
        </a>
        <a href="https://drive.google.com/file/d/1ZmYeDERiSeS0sn5zUPi325O8c5r5wCAV/view?usp=drive_link" target="_blank" rel="noopener noreferrer" class="btn">
          <i class="fas fa-file-pdf"></i> Presentation
        </a>
      </div>
    </div>
  </section>

  <section class="research-section alt" id="collider">
    <div class="container">
      <div class="research-header">
        <h2>Collider Physics for HL-LHC Upgrade</h2>
        <div class="research-meta">
          <span><i class="fas fa-university"></i> Duke University</span>
          <span><i class="fas fa-user"></i> Prof. Ashutosh Kotwal</span>
          <span><i class="fas fa-calendar"></i> Apr 2023 &ndash; Aug 2023</span>
        </div>
      </div>
      <div class="research-body">
        <p>
          As a Huang Fellow (2023), I designed track reconstruction algorithms for the HL-LHC upgrade with
          Prof. Kotwal's group. I implemented a wedge generation algorithm that segments concentric silicon
          detectors and a spacepoint divider that assigns collision data to those wedges, enabling parallelized
          real-time track-trigger reconstruction for metastable dark matter candidates. Contributions acknowledged
          in a published paper in <em>Scientific Reports</em>.
        </p>
      </div>
      <div class="research-links">
        <a href="https://drive.google.com/file/d/1LZcLsM5f-6GdxR5StXC2eNSGi0xMpccX/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="btn">
          <i class="fas fa-file-pdf"></i> Research Poster
        </a>
        <a href="https://www.nature.com/articles/s41598-025-17888-0" target="_blank" rel="noopener noreferrer" class="btn">
          <i class="fas fa-file-alt"></i> Acknowledged in Publication
        </a>
      </div>
    </div>
  </section>

</Layout>
