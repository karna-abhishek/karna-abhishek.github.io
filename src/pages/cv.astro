---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CV" active="CV" description="Curriculum Vitae — Abhishek Karna">

  <section class="page-header">
    <div class="container">
      <div style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:1rem;">
        <div>
          <h1>Curriculum Vitae</h1>
          <p>Academic background, research experience, and achievements</p>
        </div>
        <a href="/resume.pdf" target="_blank" class="btn btn-primary" style="align-self:center;">
          <i class="fas fa-file-pdf"></i> Download PDF
        </a>
      </div>
    </div>
  </section>

  <section class="cv-section">
    <div class="container">

      <!-- Education -->
      <div class="cv-block">
        <h2 class="cv-block-title"><i class="fas fa-graduation-cap"></i> Education</h2>

        <div class="cv-item">
          <div class="cv-item-header">
            <h3>Princeton University</h3>
            <span class="cv-date">Sep 2026 &ndash; Present</span>
          </div>
          <p class="cv-subtitle">PhD in Theoretical Physics</p>
          <p class="cv-subtitle">Focus: Quantum Condensed Matter Physics</p>
          <p class="cv-body" style="color: var(--text-light); font-style: italic;">Princeton, New Jersey</p>
        </div>

        <div class="cv-item cv-item-with-photo">
          <div class="cv-item-body">
            <div class="cv-item-header">
              <h3>Duke University</h3>
              <span class="cv-date">Aug 2022 &ndash; May 2026</span>
            </div>
            <p class="cv-subtitle">BS Physics and Mathematics</p>
            <p class="cv-subtitle">Certificate in Philosophy, Politics, and Economics (PPE)</p>
            <p class="cv-body" style="color: var(--text-light); font-style: italic;">Durham, North Carolina</p>
          </div>
          <img src="/photos/3.jpg" alt="Duke graduation" class="cv-photo" />
        </div>
      </div>

      <!-- Honors & Awards -->
      <div class="cv-block">
        <h2 class="cv-block-title"><i class="fas fa-trophy"></i> Honors &amp; Awards</h2>

        <div class="cv-item">
          <div class="cv-item-header">
            <h3>PSI Start, Perimeter Institute for Theoretical Physics</h3>
            <span class="cv-date">May &ndash; Jul 2025</span>
          </div>
          <p class="cv-body">
            Selected for a competitive 10-week theoretical physics program covering group theory and the Dirac
            equation, supersymmetric quantum mechanics, tensor networks in many-body systems, and cosmic
            structure formation via analytical and numerical methods.
          </p>
          <a href="https://perimeterinstitute.ca/training/undergraduate-program" target="_blank" rel="noopener noreferrer" class="cv-link">
            View Program <i class="fas fa-external-link-alt"></i>
          </a>
        </div>

        <div class="cv-item">
          <div class="cv-item-header">
            <h3>Dean's Summer Research Fellowship, Duke University</h3>
            <span class="cv-date">March 2025</span>
          </div>
          <p class="cv-body">
            Fellowship to continue theoretical work on Quantum Monte Carlo methods for the
            Shastry&ndash;Sutherland model over the summer.
          </p>
          <a href="https://undergraduateresearch.duke.edu/DSRF" target="_blank" rel="noopener noreferrer" class="cv-link">
            View Award <i class="fas fa-external-link-alt"></i>
          </a>
        </div>

        <div class="cv-item">
          <div class="cv-item-header">
            <h3>First Prize &mdash; MIT Interdisciplinary Quantum Hackathon (iQuHack)</h3>
            <span class="cv-date">January 2025</span>
          </div>
          <p class="cv-body">
            Challenge proposed by Quantinuum; work focused on simulating open and closed quantum systems
            through their Hamiltonians and Lindbladians.
          </p>
          <a href="https://github.com/AxelOA/2025-Quantinuum/tree/main" target="_blank" rel="noopener noreferrer" class="cv-link">
            View Project <i class="fas fa-external-link-alt"></i>
          </a>
        </div>

        <div class="cv-item">
          <div class="cv-item-header">
            <h3>Global Fellow 2023, Duke University</h3>
            <span class="cv-date">April 2023</span>
          </div>
          <p class="cv-body">
            Experiential learning and leadership program developing global competency. Program by Duke
            International Student Center, Office of Global Affairs, and Duke Career Center.
          </p>
          <a href="https://sites.duke.edu/globalfellows" target="_blank" rel="noopener noreferrer" class="cv-link">
            View Award <i class="fas fa-external-link-alt"></i>
          </a>
        </div>

        <div class="cv-item">
          <div class="cv-item-header">
            <h3>Huang Fellow 2023, Duke Initiative for Science and Society</h3>
            <span class="cv-date">March 2023</span>
          </div>
          <p class="cv-body">
            Highly selective program fostering a community of 20 accomplished undergraduate scholars
            trained in the sciences and grounded firmly in the liberal arts. Includes fully-funded
            summer research and career workshops.
          </p>
          <a href="https://scienceandsociety.duke.edu/learn/undergraduate-programs/huang-fellows-program/" target="_blank" rel="noopener noreferrer" class="cv-link">
            View Award <i class="fas fa-external-link-alt"></i>
          </a>
        </div>

        <div class="cv-item">
          <div class="cv-item-header">
            <h3>Karsh International Scholarship, Duke University</h3>
            <span class="cv-date">April 2022</span>
          </div>
          <p class="cv-body">
            Full-ride merit scholarship covering tuition, room and board, mandatory fees, and three
            summers of funding for research, unpaid internships, and other opportunities.
            Total value over $350,000.
          </p>
          <a href="https://ousf.duke.edu/merit-scholarships/karsh-international-scholars-program/" target="_blank" rel="noopener noreferrer" class="cv-link">
            View Award <i class="fas fa-external-link-alt"></i>
          </a>
        </div>

        <div class="cv-item">
          <div class="cv-item-header">
            <h3>Global Awardee &mdash; Beamline for Schools 2021, CERN</h3>
            <span class="cv-date">June 2021</span>
          </div>
          <p class="cv-body">
            Awarded by CERN for a research proposal on targeted cancer treatment using Delta rays.
            Received an Alpha Ray Spectrometer, Cloud Chambers, and other experimental equipment.
          </p>
          <a href="https://drive.google.com/file/d/1_fnthVck0XWeDeCWcjMJ6GQoEfg5sKKz/view" target="_blank" rel="noopener noreferrer" class="cv-link">
            View Award <i class="fas fa-external-link-alt"></i>
          </a>
        </div>
      </div>

      <!-- Co-Curricular -->
      <div class="cv-block">
        <h2 class="cv-block-title"><i class="fas fa-briefcase"></i> Co-Curricular Involvement</h2>

        <div class="cv-item">
          <div class="cv-item-header">
            <h3>Teaching Assistant — Quantum Mechanics I (Physics 464)</h3>
            <span class="cv-date">Fall 2025</span>
          </div>
          <p class="cv-body">
            Assisted Prof. Socolar in course instruction, held weekly meetings to discuss problem-setting,
            graded assignments and exams, and helped students refine their understanding.
          </p>
        </div>

        <div class="cv-item">
          <div class="cv-item-header">
            <h3>Duke Society of Physics Students (SPS)</h3>
            <span class="cv-date">2023 &ndash; 2025</span>
          </div>
          <p class="cv-body">
            <strong>Co-President (2024/25)</strong> and <strong>Event Coordinator (2023/24)</strong>.
            Led initiatives to enhance departmental engagement, organized a Physics Research Seminar
            Series and an Alumni Seminar Series over two years.
          </p>
        </div>
      </div>

      <!-- Coursework -->
      <div class="cv-block">
        <h2 class="cv-block-title"><i class="fas fa-book"></i> Selected Coursework</h2>
        <div class="coursework-grid">
          <div class="course-col">
            <h4>Physics</h4>
            <ul>
              <li>Quantum Mechanics I &amp; II</li>
              <li>Quantum Lattice Monte Carlo</li>
              <li>Frustrated Quantum Spin Systems</li>
              <li>Quantum Materials I &amp; II</li>
              <li>Novel Quantum Magnets I &amp; II</li>
              <li>General Relativity</li>
            </ul>
          </div>
          <div class="course-col">
            <h4>Mathematics</h4>
            <ul>
              <li>Representation Theory</li>
              <li>Complex Analysis</li>
              <li>Real Analysis</li>
              <li>Differential Geometry</li>
              <li>Algebraic Structures I</li>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </section>

</Layout>
