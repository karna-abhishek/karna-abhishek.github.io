  <section class="page-header">
    <div class="container">
      <h1>Publications</h1>
      <p>Manuscripts and research papers</p>
    </div>
  </section>

  <section class="publications-section">
    <div class="container">
      <ul class="pub-list">

        <li class="pub-item">
          <span class="pub-type-tag">Published</span>
          <p class="pub-item-title">Projected Density Matrix Sampling for Lattice Hamiltonians</p>
          <p class="pub-item-authors">
            <strong>Karna, A.</strong>, Wu, H. S., Chandrasekharan, S., and Kaul, R. K.
          </p>
          <p class="pub-item-venue"><em>Physical Review D</em> 113, 074511 (2026)</p>
          <div style="margin-top: 0.65rem; display: flex; gap: 0.6rem; flex-wrap: wrap;">
            <a href="https://journals.aps.org/prd/abstract/10.1103/gtbl-vsdt" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              <i class="fas fa-external-link-alt"></i> Physical Review D
            </a>
            <a href="https://arxiv.org/abs/2511.19209" target="_blank" rel="noopener noreferrer" class="btn">
