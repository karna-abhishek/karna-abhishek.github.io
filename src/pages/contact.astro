---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" active="Contact" description="Contact Abhishek Karna — Princeton University">

  <section class="page-header">
    <div class="container">
      <h1>Contact</h1>
      <p>Princeton University, Princeton, NJ</p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">
      <ul class="contact-list">

        <li class="contact-item">
          <div class="contact-icon"><i class="fas fa-envelope"></i></div>
          <div class="contact-details">
            <h3>Email</h3>
            <a href="mailto:kronos.karna@gmail.com">kronos.karna@gmail.com</a>
          </div>
        </li>

        <li class="contact-item">
          <div class="contact-icon"><i class="fab fa-linkedin"></i></div>
          <div class="contact-details">
            <h3>LinkedIn</h3>
            <a href="https://www.linkedin.com/in/abhishekkarna/" target="_blank" rel="noopener noreferrer">
              linkedin.com/in/abhishekkarna
            </a>
          </div>
        </li>

        <li class="contact-item">
          <div class="contact-icon"><i class="fas fa-graduation-cap"></i></div>
          <div class="contact-details">
            <h3>Google Scholar</h3>
            <a href="https://scholar.google.com/citations?user=fF3vhcEAAAAJ&hl=en" target="_blank" rel="noopener noreferrer">
              scholar.google.com
            </a>
          </div>
        </li>

        <li class="contact-item">
          <div class="contact-icon"><i class="fas fa-university"></i></div>
          <div class="contact-details">
            <h3>Affiliation</h3>
            <p>Department of Physics<br />Princeton University<br />Princeton, NJ 08544, USA</p>
          </div>
        </li>

      </ul>
    </div>
  </section>

</Layout>
